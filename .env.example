# Copy to .env.local. Never commit real values.

# Public site URL (used for metadata, sitemap, robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form delivery via Resend (https://resend.com).
# Without RESEND_API_KEY the form only logs to the console in development
# and returns 503 in production.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=sales@visiprotonaglobal.com
